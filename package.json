{
  "name": "stomp",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server/main.ts",
    "dev:server": "node --watch-path=src/server --watch-path=src/shared src/server/main.ts",
    "dev:web": "vite --config src/web/vite.config.ts",
    "build": "vite build --config src/web/vite.config.ts",
    "login": "node src/server/login.ts",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "node --test 'test/**/*.test.ts'",
    "budget": "node scripts/budget.ts",
    "judge:eval": "node scripts/judge-eval/eval.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-durable": "1.0.4",
    "typebox": "1.3.27",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "license": "MIT"
}
